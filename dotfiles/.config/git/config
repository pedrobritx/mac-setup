# ~/.config/git/config — shared git configuration (managed by mac-setup).
#
# Machine/person-specific values (identity, signing key, credential helper)
# are generated by scripts/git.sh into ~/.config/git/local, included below.
# That keeps this file identical on every machine.

[include]
	path = ~/.config/git/local

[core]
	excludesfile = ~/.config/git/ignore
	pager = less -FRX
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autostash = true
	autosquash = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[color]
	ui = auto

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	amend = commit --amend --no-edit
	unstage = restore --staged
	undo = reset --soft HEAD~1
	last = log -1 HEAD --stat
	lg = log --oneline --graph --decorate -20
	wip = !git add -A && git commit -m 'wip'
	aliases = config --get-regexp ^alias
